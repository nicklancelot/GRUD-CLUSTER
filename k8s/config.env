# MERN GRID CLUSTER - Configuration File
# Replace all placeholders with your actual values

# ============================================
# GCP Configuration
# ============================================
PROJECT_ID=your-gcp-project-id
CLUSTER_NAME=mern-gke-cluster
REGION=us-central1
ZONE=us-central1-a
GKE_VERSION=latest

# ============================================
# Kubernetes Configuration
# ============================================
NAMESPACE=mern-app
NUM_NODES=3
MIN_NODES=3
MAX_NODES=10
MACHINE_TYPE=n1-standard-2
DISK_SIZE=50
NETWORK_POLICY_ENABLED=true

# ============================================
# Docker Hub Configuration
# ============================================
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_PASSWORD=your-dockerhub-password
DOCKERHUB_EMAIL=your-email@example.com
REGISTRY=docker.io

# ============================================
# Application Configuration
# ============================================
APP_NAME=mern-app
APP_VERSION=v1.0.0
NODE_ENV=production
LOG_LEVEL=info

# ============================================
# Backend Configuration
# ============================================
BACKEND_REPLICAS=3
BACKEND_MIN_REPLICAS=3
BACKEND_MAX_REPLICAS=10
BACKEND_PORT=5000
BACKEND_CPU_REQUEST=200m
BACKEND_CPU_LIMIT=500m
BACKEND_MEMORY_REQUEST=256Mi
BACKEND_MEMORY_LIMIT=512Mi
BACKEND_CPU_THRESHOLD=70
BACKEND_MEMORY_THRESHOLD=80

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_REPLICAS=3
FRONTEND_MIN_REPLICAS=3
FRONTEND_MAX_REPLICAS=8
FRONTEND_PORT=80
FRONTEND_CPU_REQUEST=100m
FRONTEND_CPU_LIMIT=200m
FRONTEND_MEMORY_REQUEST=128Mi
FRONTEND_MEMORY_LIMIT=256Mi
FRONTEND_CPU_THRESHOLD=80
FRONTEND_MEMORY_THRESHOLD=85

# ============================================
# MongoDB Configuration
# ============================================
MONGO_REPLICAS=3
MONGO_VERSION=7.0.6
MONGO_STORAGE_SIZE=10Gi
MONGO_STORAGE_CLASS=standard
MONGO_CPU_REQUEST=250m
MONGO_CPU_LIMIT=1000m
MONGO_MEMORY_REQUEST=512Mi
MONGO_MEMORY_LIMIT=2Gi
MONGO_DB=mern_db
MONGO_USER=mern_user
MONGO_PASSWORD=YOUR_SECURE_MONGO_PASSWORD
MONGO_URI=mongodb+srv://mern_user:YOUR_SECURE_MONGO_PASSWORD@clustergrud.wkf8ntf.mongodb.net/mern_db

# ============================================
# Domain & SSL/TLS Configuration
# ============================================
DOMAIN_NAME=mern-app.com
API_DOMAIN=api.mern-app.com
WWW_DOMAIN=www.mern-app.com
FRONTEND_URL=https://mern-app.com
BACKEND_URL=http://mern-backend-service.mern-app.svc.cluster.local:5000
CERT_EMAIL=admin@mern-app.com
LETSENCRYPT_ENV=prod

# ============================================
# Security Configuration
# ============================================
JWT_SECRET=your-super-secure-jwt-secret-change-this
ADMIN_EMAIL=admin@mern-app.com
ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD
CORS_ORIGIN=https://mern-app.com

# ============================================
# Monitoring & Logging
# ============================================
PROMETHEUS_RETENTION=24h
PROMETHEUS_SCRAPE_INTERVAL=30s
GRAFANA_ADMIN_PASSWORD=YOUR_SECURE_GRAFANA_PASSWORD
ELK_ENABLED=false
FLUENT_BIT_ENABLED=true
LOG_RETENTION_DAYS=7
STACKDRIVER_LOGGING=true

# ============================================
# Backup & Disaster Recovery
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
GCS_BUCKET=mern-app-backups-your-project-id

# ============================================
# Performance Tuning
# ============================================
ENABLE_CACHE=true
CACHE_TTL=3600
CONNECTION_POOL_SIZE=50
NGINX_WORKER_CONNECTIONS=1024
NGINX_WORKER_PROCESSES=auto

# ============================================
# High Availability
# ============================================
HA_ENABLED=true
MULTI_AZ_ENABLED=true
POD_DISRUPTION_BUDGET=true
PDB_MIN_AVAILABLE=2

# ============================================
# Auto-scaling
# ============================================
HPA_ENABLED=true
VPA_ENABLED=false
CLUSTER_AUTOSCALER_ENABLED=true
